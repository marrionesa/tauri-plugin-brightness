# Rust
/target
**/target
**/*.rs.bk

# Node
node_modules
*.tsbuildinfo

# The compiled bindings and the IIFE bundle are generated by `npm run build`,
# but they are committed on purpose: `build.rs` embeds `api-iife.js`
# unconditionally, and `cargo publish` ships both, so a fresh clone must be able
# to build the crate without a JavaScript toolchain. CI checks that they are
# current rather than ignoring them.
crates/tauri-plugin-brightness/examples/tauri-app/node_modules

# Generated by the Tauri CLI
crates/tauri-plugin-brightness/examples/tauri-app/src-tauri/gen/schemas

# Editors
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env*
!.env.example

# Package manager credentials. A `.npmrc` can hold a publish token, so it must
# never be committed. Publishing reads the token from the user's home directory
# instead, through `npm config set`.
.npmrc

# Zwork runtime artifacts
.zwork/
